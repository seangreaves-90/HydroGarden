<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>.\testlog</ResultsDirectory>
  </RunConfiguration>
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="trx" enabled="True">
        <Configuration>
          <LogFileName>results.trx</LogFileName>
        </Configuration>
      </Logger>
      <!--<Logger friendlyName="html" enabled="True">
        <Configuration>
          <LogFileName>results.html</LogFileName>
        </Configuration>
      </Logger>-->
    </Loggers>
  </LoggerRunSettings>
</RunSettings>